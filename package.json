{
  "name": "zreader",
  "productName": "ZReader",
  "version": "2.0.10",
  "description": "ZReader v2.0.10 - Leitor de mangás desktop moderno, 100% gratuito e local-first",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"npm run dev:vite\" \"npm run dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on tcp:5173 && npm run build:electron && electron .",
    "build:electron": "esbuild electron/main.ts --bundle --platform=node --target=node22 --outfile=dist-electron/main.cjs --external:electron --external:node:sqlite && esbuild electron/preload.ts --bundle --platform=node --target=node22 --outfile=dist-electron/preload.cjs --external:electron",
    "build:renderer": "tsc && vite build",
    "build": "npm run build:electron && npm run build:renderer",
    "dist": "npm run build && electron-builder --win && python scripts/bump_version.py --clean-only",
    "dist:nsis": "npm run build && electron-builder --win nsis",
    "dist:portable": "npm run build && electron-builder --win portable",
    "build:mobile": "npm run build:renderer && npx cap sync android",
    "cap:sync": "npx cap sync android",
    "cap:open": "npx cap open android",
    "test:mobile": "tsx scripts/test-mobile-offline.ts",
    "preview": "vite preview"
  },
  "keywords": [
    "mangadex",
    "manga",
    "reader",
    "desktop",
    "electron"
  ],
  "author": "zleib-software",
  "license": "MIT",
  "dependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/cli": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/screen-orientation": "^8.0.1",
    "@capacitor/status-bar": "^8.0.3",
    "@phosphor-icons/react": "^2.1.10",
    "clsx": "^2.1.1",
    "lenis": "^1.3.26",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.25.0",
    "fake-indexeddb": "^6.2.5",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.13",
    "typescript": "^5.8.2",
    "vite": "^6.2.1",
    "wait-on": "^8.0.3"
  }
}
